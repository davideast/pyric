  "narrative": {
    "northStar": "Runtime Flow studies",
    "overview": "This document records the local example built in `lab.css`, `treatments.css`, `app.ts`, and `index.html`. It extends the existing dark Pyric preview with the user's chosen Geist and Geist Mono pairing. It establishes neither a new Pyric brand nor a public runtime theme API.\n\nThe workspace stays quiet so changes in individual chat regions remain visible. Controls introduce a delivery, annotations show observed rendering, and nearby descriptions explain each treatment's use and limitation.",
    "keyCharacteristics": [
      "Dark, flat surfaces with compact controls and aligned edges.",
      "Gap-only spacing, including inset and outer whitespace.",
      "Monospaced runtime annotations over readable chat content.",
      "Five standard and ten experimental treatments sharing real Flow marks."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Preserve listener color across treatments except where a treatment explicitly assigns color another disclosed meaning, as heat memory does for observed update counts.",
        "section": "colors"
      },
      {
        "name": "The Gap-Only Rule",
        "body": "Express spacing through layout gaps, tracks, dimensions, and empty inset cells; do not add margin or padding declarations to this example.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** preserve Geist and Geist Mono, shared alignment lines, and gap-only spacing.",
      "**Do** keep experimental effects scoped to this example and preserve reduced-motion behavior.",
      "**Do** disclose that deliveries are fixtures and that observed renders establish correlation."
    ],
    "donts": [
      "**Don't** describe heat as CPU cost, dimensions as render duration, or fixture sequence numbers as traced dependencies.",
      "**Don't** promote these experimental treatments into a public theme API or a new brand identity."
    ]
  }
