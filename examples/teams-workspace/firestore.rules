rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /workspaces/orbit/{document=**} { allow read, write: if request.auth != null; }
  match /scenario-denials/{id} { allow read: if request.auth != null; allow write: if request.auth != null && request.resource.data.budget >= 0; }
  match /scenarios/{document=**} { allow read, write: if request.auth != null; }
 }
}
