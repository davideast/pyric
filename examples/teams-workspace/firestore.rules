rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /workspaces/orbit/channels/{channel}/messages/{message} {
   allow read: if request.auth != null;
   allow create: if request.auth != null && request.resource.data.author == request.auth.uid;
   allow update: if request.auth != null
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
   allow delete: if request.auth != null && resource.data.author == request.auth.uid;
  }
  match /scenario-denials/{id} { allow read: if request.auth != null; allow write: if request.auth != null && request.resource.data.budget >= 0; }
  match /scenarios/{document=**} { allow read, write: if request.auth != null; }
 }
}
