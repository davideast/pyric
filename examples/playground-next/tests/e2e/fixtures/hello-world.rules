rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open read on the proof collection — the fixture app does an
    // unauthenticated getDocs, so reads must be allowed without auth.
    // Writes are denied; the SA-driven seed writes via the REST API
    // bypassing rules.
    match /proof/{doc} {
      allow read: if true;
      allow write: if false;
    }
    // Default-deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
