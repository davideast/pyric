{
  "id": "notes-required-fields",
  "domain": "notes",
  "auth": "email/password",
  "security": "owner-only + create-time field validation",
  "prompt": "Build a notes app where a signed-in user creates notes at /notes/{noteId} that must include a string 'title' and an 'ownerId' equal to their uid; only the owner can read a note. Use email/password sign-in. Write the Firestore rules and a minimal App.tsx.",
  "cases": [
    { "method": "create", "path": "notes/n1", "auth": { "uid": "alice" }, "data": { "title": "groceries", "ownerId": "alice" }, "expect": "ALLOW" },
    { "method": "create", "path": "notes/n1", "auth": { "uid": "alice" }, "data": { "ownerId": "alice" }, "expect": "DENY" },
    { "method": "create", "path": "notes/n1", "auth": { "uid": "alice" }, "data": { "title": "x", "ownerId": "bob" }, "expect": "DENY" },
    { "method": "get", "path": "notes/n1", "auth": { "uid": "alice" }, "resource": { "ownerId": "alice" }, "expect": "ALLOW" },
    { "method": "get", "path": "notes/n1", "auth": { "uid": "bob" }, "resource": { "ownerId": "alice" }, "expect": "DENY" }
  ]
}
