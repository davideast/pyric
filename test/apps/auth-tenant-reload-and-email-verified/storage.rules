rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /tenants/{tenant}/{name} {
      allow write: if request.auth != null
        && request.auth.token.firebase.tenant == tenant;
    }
    match /verified/{name} {
      allow write: if request.auth != null
        && request.auth.token.email_verified == true;
    }
  }
}
