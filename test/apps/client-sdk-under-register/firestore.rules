rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /server/{id} {
      allow read, write: if true;
      match /{subcollection}/{docId} { allow read, write: if true; }
    }
    match /writeOnly/{docId} {
      allow write: if true;
      allow read: if false;
    }
    match /userDocs/{uid}/items/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
