                "collectionId": "bookings"
              }
            ],
            "orderBy": [
              {
                "field": {
                  "fieldPath": "__name__"
                },
                "direction": "ASCENDING"
              }
            ]
          },
          "parent": "projects/demo-live-traffic/databases/(default)/documents"
        }
      },
