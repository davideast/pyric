// A decoy: firebase.json's firestore array does not name this file, so
// `firebase deploy` never deploys it and pyric must not serve it.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /open/{id} {
      allow read, write: if true;
    }
    match /locked/{id} {
      allow read, write: if true;
    }
  }
}
