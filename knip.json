{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": ["packages/playground"],
  "workspaces": {
    "packages/cli": {
      "entry": [
        "src/cli/index.ts!",
        "src/serve/entries/*.ts!",
        "src/serve/worker/entry.ts!",
        "src/serve/vite-plugin.ts!"
      ]
    },
    "packages/conformance": {
      "entry": [
        "registry/*.ts",
        "src/run.ts",
        "src/capture/rtdb-climb/*.probe.ts",
        "src/capture/rtdb-disconnect/preflight.ts"
      ]
    }
  }
}
