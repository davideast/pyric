rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member() { return request.auth != null && request.auth.uid in ['alice', 'bob']; }
  match /boards/{board} { allow read, write: if member(); }
  match /pixels/{pixel} { allow read, write: if member(); }
  match /claims/{color} {
   allow read: if member();
   allow create: if member() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
   allow delete: if member() && resource.data.uid == request.auth.uid;
  }
  match /fencedClaims/{color} {
   allow read: if member();
   allow create: if member() && request.resource.data.keys().hasOnly(['uid', 'epoch'])
    && request.resource.data.uid == request.auth.uid && request.resource.data.epoch == 1;
   allow update: if member() && request.resource.data.keys().hasOnly(['uid', 'epoch'])
    && request.resource.data.epoch is int
    && ((resource.data.uid == request.auth.uid && request.resource.data.uid == null && request.resource.data.epoch == resource.data.epoch)
     || (resource.data.uid == null && request.resource.data.uid == request.auth.uid && request.resource.data.epoch == resource.data.epoch + 1));
  }
  match /fencedPixels/{pixel} {
   allow read: if member();
   allow create, update: if member() && request.resource.data.keys().hasOnly(['color', 'epoch'])
    && request.resource.data.epoch is int
    && get(/databases/$(database)/documents/fencedClaims/$(request.resource.data.color)).data.uid == request.auth.uid
    && get(/databases/$(database)/documents/fencedClaims/$(request.resource.data.color)).data.epoch == request.resource.data.epoch;
  }
  match /claimedPixels/{pixel} {
   allow read: if member();
   allow create, update: if member() && request.resource.data.keys().hasOnly(['color'])
    && get(/databases/$(database)/documents/claims/$(request.resource.data.color)).data.uid == request.auth.uid;
  }
 }
}