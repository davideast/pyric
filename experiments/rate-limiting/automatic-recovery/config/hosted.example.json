{
  "_comment": "Hosted config for Cloud Run + Firestore. Requires explicit deployment approval. realInferenceEnabled must remain false.",
  "schemaVersion": 1,
  "experimentId": "automatic-recovery",
  "variantId": "autonomous-fenced-reconciler",
  "profile": "hosted",
  "backend": {
    "kind": "hosted",
    "project": "digame-mas",
    "database": "allowance-experiments",
    "region": "us-east4"
  },
  "execution": {
    "kind": "cloud-run",
    "serviceUrl": "<FILL_IN_AFTER_DEPLOYMENT>",
    "gatewayCount": 1,
    "recoveryWorkerCount": 2
  },
  "provider": { "kind": "fixture", "profile": "observable" },
  "clock": { "kind": "wall" },
  "seed": 18,
  "policyVersion": "integrated-v1",
  "realInferenceEnabled": false,
  "limits": {
    "maxRequests": 200,
    "maxCommands": 200,
    "maxDurationMs": 120000,
    "maxTransactionAttempts": 8
  }
}
