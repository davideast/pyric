function keptRights(flags, piece, from, to) {
  return (flags[0] && piece != 'wk' && from != 'h1' && to != 'h1' ? 'K' : '')
    + (flags[1] && piece != 'wk' && from != 'a1' && to != 'a1' ? 'Q' : '')
    + (flags[2] && piece != 'bk' && from != 'h8' && to != 'h8' ? 'k' : '')
    + (flags[3] && piece != 'bk' && from != 'a8' && to != 'a8' ? 'q' : '');
}
