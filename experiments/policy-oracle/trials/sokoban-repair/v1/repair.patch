@@ -0,0 +1,13 @@
+import { expect, test } from 'bun:test';
+import { compilePolicy } from '../../src/policy/index.js';
+
+test('Firestore lowering preserves the operands of strict less-than', () => {
+  const policy = compilePolicy(`transition decrease {
+    require smaller { return after.value < before.value; }
+  }`);
+  const [requirement] = policy.firestore({
+    'after.value': 'request.resource.data.value',
+    'before.value': 'resource.data.value',
+  });
+  expect(requirement.predicate).toBe('request.resource.data.value < resource.data.value');
+});
