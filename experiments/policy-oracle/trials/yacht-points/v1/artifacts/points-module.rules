rules_version = '2+modules';

export function scoreRoll(category, dice) {
  let faces = {'ones': 1, 'twos': 2, 'threes': 3, 'fours': 4, 'fives': 5, 'sixes': 6};
  let sum = dice[0] + dice[1] + dice[2] + dice[3] + dice[4];
  let distinct = dice.toSet();
  let firstCount = 5 - dice.removeAll([dice[0]]).size();
  return category in faces ? faces[category] * (5 - dice.removeAll([faces[category]]).size()) : category == 'choice' ? sum : category == 'yacht' ? (distinct.size() == 1 ? 50 : 0) : category == 'fullHouse' ? (distinct.size() == 2 && firstCount in [2, 3] ? sum : 0) : category == 'fourKind' ? (firstCount >= 4 ? 4 * dice[0] : (5 - dice.removeAll([dice[1]]).size() >= 4 ? 4 * dice[1] : 0)) : category == 'littleStraight' ? (distinct == [1, 2, 3, 4, 5].toSet() ? 30 : 0) : category == 'bigStraight' && distinct == [2, 3, 4, 5, 6].toSet() ? 30 : 0;
}
