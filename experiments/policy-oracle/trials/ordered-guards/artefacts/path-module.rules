rules_version = '2+modules';

export function pathClear(board, x, y, dx, dy) {
  let files = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];
  let ranks = ['1', '2', '3', '4', '5', '6', '7', '8'];
  let sx = dx == 0 ? 0 : (dx > 0 ? 1 : -1);
  let sy = dy == 0 ? 0 : (dy > 0 ? 1 : -1);
  return 1 * sx == dx && 1 * sy == dy ? true : board[files[x + 1 * sx] + ranks[y + 1 * sy]] != '' ? false : 2 * sx == dx && 2 * sy == dy ? true : board[files[x + 2 * sx] + ranks[y + 2 * sy]] != '' ? false : 3 * sx == dx && 3 * sy == dy ? true : board[files[x + 3 * sx] + ranks[y + 3 * sy]] != '' ? false : 4 * sx == dx && 4 * sy == dy ? true : board[files[x + 4 * sx] + ranks[y + 4 * sy]] != '' ? false : 5 * sx == dx && 5 * sy == dy ? true : board[files[x + 5 * sx] + ranks[y + 5 * sy]] != '' ? false : 6 * sx == dx && 6 * sy == dy ? true : board[files[x + 6 * sx] + ranks[y + 6 * sy]] != '' ? false : true;
}
