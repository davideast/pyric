use extension bounded;

export function pathClear(board, x, y, dx, dy) {
  let files = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];
  let ranks = ['1', '2', '3', '4', '5', '6', '7', '8'];
  let stepX = dx < 0 ? -1 : (dx > 0 ? 1 : 0);
  let stepY = dy < 0 ? -1 : (dy > 0 ? 1 : 0);
  let distance = dx != 0 ? dx * stepX : dy * stepY;
  return !bounded.any([1, 2, 3, 4, 5, 6], i =>
    i < distance && board[files[x + i * stepX] + ranks[y + i * stepY]] != '', 6);
}
