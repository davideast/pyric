rules_version = '2+modules';

export function pathClear(board, x, y, dx, dy) {
  let sx = dx < 0 ? -1 : (dx > 0 ? 1 : 0);
  let sy = dy < 0 ? -1 : (dy > 0 ? 1 : 0);
  let distance = dx * sx > dy * sy ? dx * sx : dy * sy;
  let files = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];
  let ranks = ['1', '2', '3', '4', '5', '6', '7', '8'];
  return (1 < distance ? board[files[x + sx * 1] + ranks[y + sy * 1]] != '' : false) ? false : (2 < distance ? board[files[x + sx * 2] + ranks[y + sy * 2]] != '' : false) ? false : (3 < distance ? board[files[x + sx * 3] + ranks[y + sy * 3]] != '' : false) ? false : (4 < distance ? board[files[x + sx * 4] + ranks[y + sy * 4]] != '' : false) ? false : (5 < distance ? board[files[x + sx * 5] + ranks[y + sy * 5]] != '' : false) ? false : (6 < distance ? board[files[x + sx * 6] + ranks[y + sy * 6]] != '' : false) ? false : true;
}
