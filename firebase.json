{
  "hosting": {
    "site": "pyric-site",
    "public": "dist/site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/docs/set-up-your-agent{,/**}",
        "destination": "/docs/set-up-an-agent/",
        "type": 301
      },
      {
        "source": "/docs/audit-your-rules{,/**}",
        "destination": "/docs/audit-a-ruleset/",
        "type": 301
      },
      {
        "source": "/docs/what-your-agent-can-do{,/**}",
        "destination": "/docs/agent-mcp-tools/",
        "type": 301
      },
      {
        "source": "/docs/what-an-agent-can-do{,/**}",
        "destination": "/docs/agent-mcp-tools/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/docs/**",
        "destination": "/docs/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.md",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          }
        ]
      },
      {
        "source": "/docs/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}