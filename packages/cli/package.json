{
  "name": "@pyric/cli",
  "version": "0.1.0-alpha.20",
  "license": "Apache-2.0",
  "homepage": "https://pyric.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davideast/pyric.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/davideast/pyric/issues"
  },
  "description": "Pyric CLI for local sandbox development, verification, artifact generation, and agent bridges.",
  "type": "module",
  "exports": {
    "./credentials/node": {
      "types": "./dist/credentials/node/index.d.ts",
      "import": "./dist/credentials/node/index.js"
    },
    "./verify": {
      "types": "./dist/verify/index.d.ts",
      "import": "./dist/verify/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./conformance/browser": {
      "types": "./dist/conformance/browser.d.ts",
      "import": "./dist/conformance/browser.js"
    },
    "./conformance/docs": {
      "types": "./dist/conformance/docs.d.ts",
      "import": "./dist/conformance/docs.js"
    },
    "./assurance": {
      "types": "./dist/assurance/index.d.ts",
      "import": "./dist/assurance/index.js"
    },
    "./assurance/browser": {
      "types": "./dist/assurance/browser.d.ts",
      "import": "./dist/assurance/browser.js"
    },
    "./bridge": {
      "types": "./dist/bridge/server.d.ts",
      "node": {
        "types": "./dist/bridge/server.d.ts",
        "import": "./dist/bridge/server.js"
      },
      "browser": {
        "types": "./dist/bridge/client.d.ts",
        "import": "./dist/bridge/client.js"
      },
      "default": {
        "types": "./dist/bridge/server.d.ts",
        "import": "./dist/bridge/server.js"
      }
    },
    "./bridge/client": {
      "types": "./dist/bridge/client.d.ts",
      "import": "./dist/bridge/client.js"
    },
    "./discover": {
      "types": "./dist/discover/index.d.ts",
      "import": "./dist/discover/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./bundler": {
      "types": "./dist/bundler/index.d.ts",
      "import": "./dist/bundler/index.js"
    },
    "./serve/worker": {
      "types": "./dist/serve/worker/index.d.ts",
      "import": "./dist/serve/worker/index.js"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "node": {
        "types": "./dist/remote/index.d.ts",
        "import": "./dist/remote/index.js"
      }
    },
    "./register": {
      "types": "./dist/register/index.d.ts",
      "node": {
        "types": "./dist/register/index.d.ts",
        "import": "./dist/register/index.js"
      }
    },
    "./register/app-bridge": {
      "types": "./dist/register/app-bridge.d.ts",
      "node": {
        "types": "./dist/register/app-bridge.d.ts",
        "import": "./dist/register/app-bridge.js"
      }
    }
  },
  "bin": {
    "pyric": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "bun run scripts/generate-service-command-registry.ts && (test \"${PYRIC_CONFORMANCE_READY:-0}\" = \"1\" || bun run ../../packages/conformance/src/generate-projections.ts --write)",
    "build": "tsc && bun run scripts/postbuild.ts",
    "pretest": "bash ../../scripts/build.sh --packages-only",
    "test": "bun test",
    "test:app-conformance": "playwright test app-deletion.pw.ts app-multi-app.pw.ts ai-worker-boundary.pw.ts messaging-app-boundary.pw.ts --config test/e2e/playwright.config.ts",
    "test:e2e:cli": "playwright test --config test/e2e/site-cli/playwright.config.ts",
    "test:site-cli": "playwright test --config test/e2e/site-cli/playwright.config.ts",
    "test:site-static": "playwright test --config test/e2e/site-static/playwright.config.ts",
    "test:soak": "playwright test --config test/e2e/soak/playwright.config.ts",
    "pretypecheck": "bash ../../scripts/build.sh --packages-only",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "compile": "bun scripts/compile.ts",
    "release": "bun scripts/release.ts",
    "smoke:standalone": "bun scripts/standalone-smoke.ts",
    "smoke:vendor": "bun scripts/standalone-vendor-smoke.ts"
  },
  "dependencies": {
    "@inbrowser/agent": "0.4.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "create-pyric": "workspace:*",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.0.0",
    "pyric": "workspace:*",
    "pyric-admin": "workspace:*",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@pyric/conformance": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/ws": "^8.5.0",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^5.0.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
