rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tenants/{tenant}/profiles/{uid} {
      allow read: if request.auth.uid == uid && request.auth.token.firebase.tenant == tenant;
      allow write: if request.auth.uid == uid && request.auth.token.firebase.tenant == tenant
        && request.auth.token.role == 'editor';
    }
  }
}
