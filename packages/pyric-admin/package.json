{
  "name": "pyric-admin",
  "version": "0.1.0-alpha.17",
  "license": "Apache-2.0",
  "homepage": "https://pyric.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davideast/pyric.git",
    "directory": "packages/pyric-admin"
  },
  "bugs": {
    "url": "https://github.com/davideast/pyric/issues"
  },
  "description": "Firebase Admin-shaped adapters for the Pyric development sandbox.",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./firestore": {
      "types": "./dist/firestore/index.d.ts",
      "import": "./dist/firestore/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "import": "./dist/database/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./messaging": {
      "types": "./dist/messaging/index.d.ts",
      "import": "./dist/messaging/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pyric": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "firebase-admin": "^13.0.0",
    "typescript": "^5.7.0",
    "fake-indexeddb": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
