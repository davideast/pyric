    },
    "./security-rules": {
      "types": "./dist/security-rules/index.d.ts",
      "import": "./dist/security-rules/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pyric": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "firebase-admin": "^13.0.0",
    "typescript": "^5.7.0",
