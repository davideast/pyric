// Multiple match blocks for the same path (rules OR together)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if true;
    }

    // Second match block for same path — both apply
    match /posts/{postId} {
      allow write: if request.auth != null;
    }
  }
}
