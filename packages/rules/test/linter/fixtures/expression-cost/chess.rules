        return !kingMoved && !rookMoved && request.resource.data.moveFrom == castle.kingFrom && request.resource.data.moveTo == castle.kingTo && resource.data[castle.between[0]] == '' && resource.data[castle.between[1]] == '' && resource.data[castle.between[2]] == '';
      }
