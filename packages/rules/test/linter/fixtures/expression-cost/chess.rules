      allow update: if request.auth != null && resource.data.status == 'waiting' && resource.data.guest == '' && request.resource.data.guest == request.auth.uid && request.auth.uid != resource.data.host && request.resource.data.status == 'playing' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'status']);
      allow delete: if request.auth != null && resource.data.status == 'waiting' && request.auth.uid == resource.data.host;
