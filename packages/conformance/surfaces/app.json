{
  "schema": "pyric.conformance.surface.v2",
  "kind": "mirror",
  "developerSurface": "app",
  "censusSurface": "app",
  "upstream": "firebase/app",
  "mirrors": [
    "pyric/app"
  ],
  "privateRuntimeExports": [
    "_DEFAULT_ENTRY_NAME",
    "_addComponent",
    "_addOrOverwriteComponent",
    "_apps",
    "_clearComponents",
    "_components",
    "_getProvider",
    "_isFirebaseApp",
    "_isFirebaseServerApp",
    "_isFirebaseServerAppSettings",
    "_registerComponent",
    "_removeServiceInstance",
    "_serverApps",
    "_setTrustedScriptSrc"
  ],
  "observationPrefixes": [
    "app-registry-",
    "app-production-"
  ],
  "coverage": true,
  "conformanceSuite": "packages/pyric/test/app/oracle-conformance.test.ts",
  "captureRigs": [
    "app-registry",
    "app-production",
    "sdk-probes"
  ],
  "registry": "app",
  "dispositions": []
}
