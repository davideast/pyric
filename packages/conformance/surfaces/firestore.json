{
  "schema": "pyric.conformance.surface.v2",
  "kind": "mirror",
  "developerSurface": "firestore",
  "censusSurface": "firestore",
  "upstream": "firebase/firestore",
  "mirrors": [
    "pyric/firestore"
  ],
  "privateRuntimeExports": [
    "_AutoId",
    "_ByteString",
    "_DatabaseId",
    "_DocumentKey",
    "_EmptyAppCheckTokenProvider",
    "_EmptyAuthCredentialsProvider",
    "_FieldPath",
    "_TestingHooks",
