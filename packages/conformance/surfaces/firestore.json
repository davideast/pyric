  "registry": "firestore",
  "conformanceSuite": "packages/pyric/test/firestore/oracle-conformance.test.ts",
  "climb": true,
  "dispositions": [
    {
      "id": "firestore.cache-indexes",
      "availability": "deferred",
      "reasonCode": "implementation-deferred",
      "summary": "Index-tuning / GC-policy APIs have no real knob to turn in an in-memory sandbox today, but sibling cache-factory tokens are already honest inert tokens; these are buildable the same way and not genuinely out of scope.",
      "evidenceRefs": ["upstream:firebase/firestore"],
      "symbols": [
        "CACHE_SIZE_UNLIMITED",
        "PersistentCacheIndexManager",
        "getPersistentCacheIndexManager",
        "deleteAllPersistentCacheIndexes",
        "enablePersistentCacheIndexAutoCreation",
        "disablePersistentCacheIndexAutoCreation",
        "setIndexConfiguration"
      ]
    },
    {
      "id": "firestore.bundle-loading",
      "availability": "deferred",
      "reasonCode": "implementation-deferred",
      "summary": "Bundle-loading depends on a protobuf packaging format not modeled in the sandbox yet — a data/parsing problem, not external infrastructure, so it is buildable rather than genuinely un-modelable.",
      "evidenceRefs": ["upstream:firebase/firestore"],
      "symbols": [
        "loadBundle",
        "namedQuery",
        "LoadBundleTask"
      ]
    },
    {
      "id": "firestore.runtime-class-values",
      "availability": "deferred",
      "reasonCode": "implementation-deferred",
      "summary": "These Firebase classes and constraint objects are present in Pyric's type surface but are not exported as runtime constructor values. Runtime identity and instanceof-compatible tokens remain unbuilt and cannot be credited by type-only mirrors.",
      "evidenceRefs": ["upstream:firebase/firestore"],
      "symbols": [
        "AbstractUserDataWriter",
        "AggregateField",
        "AggregateQuerySnapshot",
        "CollectionReference",
        "DocumentReference",
        "DocumentSnapshot",
        "Firestore",
        "FirestoreError",
        "Query",
        "QueryCompositeFilterConstraint",
        "QueryConstraint",
        "QueryDocumentSnapshot",
        "QueryEndAtConstraint",
        "QueryFieldFilterConstraint",
        "QueryLimitConstraint",
        "QueryOrderByConstraint",
        "QuerySnapshot",
        "QueryStartAtConstraint",
        "SnapshotMetadata",
        "Transaction",
        "WriteBatch"
      ]
    },
    {
      "id": "firestore.aggregate-equality-helpers",
      "availability": "deferred",
      "reasonCode": "implementation-deferred",
      "summary": "Aggregate-field and aggregate-snapshot equality helpers are exported upstream but have no Pyric runtime implementation yet.",
      "evidenceRefs": ["upstream:firebase/firestore"],
      "symbols": [
        "aggregateFieldEqual",
        "aggregateQuerySnapshotEqual"
      ]
    },
    {
      "id": "firestore.snapshot-json-resume",
      "availability": "deferred",
      "reasonCode": "implementation-deferred",
      "summary": "Snapshot JSON reconstruction and listener-resume helpers depend on serialized snapshot state that the sandbox has not modeled.",
      "evidenceRefs": ["upstream:firebase/firestore"],
      "symbols": [
        "documentSnapshotFromJSON",
        "onSnapshotResume",
        "querySnapshotFromJSON"
      ]
    },
    {
      "id": "firestore.public-write-plumbing",
      "availability": "deferred",
      "reasonCode": "implementation-deferred",
      "summary": "The upstream package publicly exports these low-level configuration/write helpers, but Pyric does not expose equivalent runtime plumbing yet.",
      "evidenceRefs": ["upstream:firebase/firestore"],
      "symbols": [
        "ensureFirestoreConfigured",
        "executeWrite"
      ]
    }
  ]
}
