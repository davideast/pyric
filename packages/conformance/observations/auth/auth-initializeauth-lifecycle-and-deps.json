{
  "name": "auth-initializeauth-lifecycle-and-deps",
  "matrixRow": "",
  "rowIds": [],
  "description": "initializeAuth(app, deps?) returns a live Auth handle shared with getAuth(app), while repeated initializeAuth calls (or initializeAuth with deps after getAuth) throw auth/already-initialized.",
  "observedAt": "2026-11-18T09:53:42.621Z",
  "fbSdkVersion": "12.19.0",
  "projectId": "digame-mas",
  "behavior": {
    "liveHandleWorks": {
      "appMatches": true,
      "getAuthReturnsSameHandle": true,
      "currentUserMatchesSignedIn": true,
      "uidMatchesCreatedUser": true
    },
    "secondInitNoDeps": {
      "threw": true,
      "errorName": "FirebaseError",
      "isFirebaseError": true,
      "code": "auth/already-initialized"
    },
    "secondInitWithDeps": {
      "threw": false,
      "errorName": null,
      "isFirebaseError": false,
      "code": null
    },
    "initAfterGetNoDeps": {
      "threw": false,
      "errorName": null,
      "isFirebaseError": false,
      "code": null,
      "returnsSameHandleAsGetAuth": true
    },
    "initAfterGetWithDeps": {
      "threw": true,
      "errorName": "FirebaseError",
      "isFirebaseError": true,
      "code": "auth/already-initialized"
    }
  }
}
