  "fbSdkVersion": "12.19.0",
  "projectId": "digame-mas",
  "behavior": {
    "afterSetUser": {
      "currentUserNonNull": true,
      "uidMatchesSource": true,
      "clonesAcrossAuthInstances": true,
      "firedMatchedUidTransition": true
    },
    "afterClearNull": {
      "secondaryCurrentUserIsNull": true,
      "primaryCurrentUserIntact": true,
      "firedNullTransition": true
    },
    "tenantMismatchAttempt": {
      "threw": true,
      "errorName": "FirebaseError",
      "isFirebaseError": true,
      "code": "auth/tenant-id-mismatch"
    },
    "tenantCurrentUserRemainsNull": true
  }
