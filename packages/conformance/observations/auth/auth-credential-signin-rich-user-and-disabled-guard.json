{
  "name": "auth-credential-signin-rich-user-and-disabled-guard",
  "matrixRow": "auth#47a",
  "rowIds": [
    "auth#47a",
    "auth#70"
  ],
  "description": "signInWithCredential preserves rich User profile fields and reference identity with auth.currentUser, records the credential providerId, and rejects disabled accounts with auth/user-disabled before mutating auth state.",
  "observedAt": "2026-11-18T21:55:09.098Z",
  "fbSdkVersion": "12.19.0",
  "projectId": "digame-mas",
  "behavior": {
    "richCredentialSignIn": {
      "credUserSameRefAsCurrentUser": true,
      "emailMatchesSeeded": true,
      "displayName": "Rich Profile User",
      "photoURL": "https://example.com/rich-avatar.png",
      "emailVerified": true,
      "isAnonymous": false,
      "providerIds": [
        "password"
      ]
    },
    "disabledCredentialSignInWhileSignedIn": {
      "attempt": {
        "threw": true,
        "errorName": "FirebaseError",
        "isFirebaseError": true,
        "code": "auth/user-disabled"
      },
      "currentUserPreservedRef": true,
      "currentUserPreservedUid": true,
      "authStateTransitionsDuringFailure": 0
    },
    "disabledCredentialSignInWhenSignedOut": {
      "attempt": {
        "threw": true,
        "errorName": "FirebaseError",
        "isFirebaseError": true,
        "code": "auth/user-disabled"
      },
      "currentUserStaysNull": true
    }
  }
}
