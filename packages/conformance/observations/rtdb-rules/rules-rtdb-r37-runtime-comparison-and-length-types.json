    "FUZ-3: string plus number under || true (\"5\" + 1 == \"none\" || true)": "ALLOW",
    "FUZ-3: object plus string ({a:1} + \"!\" == \"[object Object]!\")": "DENY",
    "FUZ-3: object plus number under || true ({a:1} + 1 == 0 || true)": "DENY",
