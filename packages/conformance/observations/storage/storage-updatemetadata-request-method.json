    "sameObjectGranularVerb": {
      "initialSize": 5,
      "initialCustomMetadata": {
        "stage": "seed"
      },
      "allowCreateVerb": {
        "verdict": "DENY",
        "threw": true,
        "code": "storage/unauthorized"
      },
      "afterAllowCreateVerbCustomMetadata": {
        "stage": "seed"
      },
      "afterAllowCreateVerbMetagenerationChanged": false,
      "allowUpdateVerb": {
        "verdict": "ALLOW",
        "threw": false,
        "code": null
