  "behavior": {
    "get: resource.name ends in .png → allow (extension guard)": "ALLOW",
    "get: resource.name ends in .txt → deny (extension guard)": "DENY",
    "get: resource.name absent → deny (absent-property error, no false-allow)": "DENY",
    "delete: within 1h of timeCreated → allow (freshness)": "ALLOW",
    "delete: more than 1h after timeCreated → deny (freshness)": "DENY",
    "update: timeCreated == updated (never modified) → allow (immutability)": "ALLOW",
    "update: timeCreated != updated (already modified) → deny (immutability)": "DENY",
    "get: resource.name != literal, name present → allow": "ALLOW",
    "get: resource.name != literal, name ABSENT → deny (error survives negation)": "DENY"
