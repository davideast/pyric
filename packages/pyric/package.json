{
  "name": "pyric",
  "version": "0.1.0-alpha.8",
  "license": "Apache-2.0",
  "homepage": "https://pyric.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davideast/pyric.git",
    "directory": "packages/pyric"
  },
  "bugs": {
    "url": "https://github.com/davideast/pyric/issues"
  },
  "description": "Firebase for agents \u2014 modular Web SDK adapters (firestore, auth, database, storage) with swappable sandbox/prod backends, plus rules tooling and in-process sandbox. Mirrors firebase.",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./app/register": {
      "types": "./dist/app/register.d.ts",
      "import": "./dist/app/register.js"
    },
    "./app/internal": {
      "types": "./dist/app/internal.d.ts",
      "import": "./dist/app/internal.js"
    },
    "./firestore": {
      "types": "./dist/firestore/index.d.ts",
      "import": "./dist/firestore/index.js"
    },
    "./firestore/internal": {
      "types": "./dist/firestore/internal/index.d.ts",
      "import": "./dist/firestore/internal/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js"
    },
    "./ai/internal": {
      "types": "./dist/ai/internal.d.ts",
      "import": "./dist/ai/internal.js"
    },
    "./ai/scripting": {
      "types": "./dist/ai/scripting.d.ts",
      "import": "./dist/ai/scripting.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "import": "./dist/database/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./storage/internal": {
      "types": "./dist/storage/internal.d.ts",
      "import": "./dist/storage/internal.js"
    },
    "./messaging": {
      "types": "./dist/messaging/index.d.ts",
      "import": "./dist/messaging/index.js"
    },
    "./messaging/sw": {
      "types": "./dist/messaging/sw.d.ts",
      "import": "./dist/messaging/sw.js"
    },
    "./messaging/internal": {
      "types": "./dist/messaging/internal.d.ts",
      "import": "./dist/messaging/internal.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js"
    },
    "./firestore-values": {
      "types": "./dist/firestore-values/index.d.ts",
      "import": "./dist/firestore-values/index.js"
    },
    "./rules/internal": {
      "types": "./dist/rules/internal/index.d.ts",
      "import": "./dist/rules/internal/index.js"
    },
    "./rules/internal/node": {
      "types": "./dist/rules/internal/node.d.ts",
      "import": "./dist/rules/internal/node.js"
    },
    "./rules/internal/extract": {
      "types": "./dist/rules/internal/extract.d.ts",
      "import": "./dist/rules/internal/extract.js"
    },
    "./rules/internal/rtdb": {
      "types": "./dist/rules/internal/rtdb.d.ts",
      "import": "./dist/rules/internal/rtdb.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "import": "./dist/sandbox/index.js"
    },
    "./sandbox/firestore": {
      "types": "./dist/firestore/sandbox-controls.d.ts",
      "import": "./dist/firestore/sandbox-controls.js"
    },
    "./sandbox/database": {
      "types": "./dist/database/sandbox-controls.d.ts",
      "import": "./dist/database/sandbox-controls.js"
    },
    "./sandbox/internal": {
      "types": "./dist/sandbox/internal/index.d.ts",
      "import": "./dist/sandbox/internal/index.js"
    },
    "./sandbox/admin-compat": {
      "types": "./dist/sandbox/admin-compat.d.ts",
      "import": "./dist/sandbox/admin-compat.js"
    },
    "./sandbox/admin-firestore": {
      "types": "./dist/sandbox/admin-firestore/index.d.ts",
      "import": "./dist/sandbox/admin-firestore/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "inline-grammar": "bun run scripts/inline-grammar.ts",
    "inline-stdlib": "bun run scripts/inline-stdlib.ts",
    "prebuild": "(bun run inline-grammar 2>/dev/null || true) && (bun run inline-stdlib 2>/dev/null || true)",
    "build": "tsc && bun run scripts/copy-assets.ts 2>/dev/null || tsc",
    "test": "bun test",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inbrowser/agent": "0.4.2",
    "fake-indexeddb": "^6.0.0",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.0.0",
    "js-md5": "^0.8.3",
    "js-sha256": "^0.11.0",
    "ohm-js": "^17.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "pyricUnreleasedExports": [
    "./ai",
    "./ai/scripting",
    "./messaging",
    "./messaging/internal",
    "./messaging/sw"
  ]
}
