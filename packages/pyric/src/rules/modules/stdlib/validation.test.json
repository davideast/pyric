    "data": {
      "status": "draft"
    }
  },
  {
    "description": "isOneOf denies an unlisted value",
    "expectation": "DENY",
    "method": "create",
    "path": "test/doc1",
    "auth": {
      "uid": "user1"
    },
    "wrapFunction": "isOneOf",
    "wrapOperation": "create",
    "wrapCallExpr": "isOneOf('status', ['draft', 'published'])",
    "data": {
      "status": "nuked"
    }
  },
  {
    "description": "isOneOf denies a missing field",
    "expectation": "DENY",
    "method": "create",
    "path": "test/doc1",
    "auth": {
      "uid": "user1"
    },
    "wrapFunction": "isOneOf",
    "wrapOperation": "create",
    "wrapCallExpr": "isOneOf('status', ['draft', 'published'])",
    "data": {
