      "auth": {
        "uid": "user1"
      },
      "resource": {
        "c0r5": "h",
        "c1r4": "",
        "currentTurn": "host",
        "host": "user1"
      },
      "data": {
        "c0r5": "",
        "c1r4": "h",
        "moveFrom": "c0r5",
        "moveTo": "c1r4",
        "currentTurn": "host",
        "host": "user1"
      },
      "wrapFunction": "validSimpleMove",
      "wrapOperation": "update",
      "wrapCallExpr": "validSimpleMove(get(/databases/$(database)/documents/gameConfig/checkers).data)",
      "functionMocks": [
        {
          "function": "get",
          "path": "gameConfig/checkers",
          "result": {
            "moves": {
              "h": {
                "c0r5": {
                  "c1r4": true
                }
              }
            },
            "jumps": {
              "h": {
                "c2r5": {
                  "c0r3": "c1r4"
                }
              }
            }
          }
        }
      ]
    },
