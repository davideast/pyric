    "auth": { "uid": "user1" },
    "data": { "moveCount": 5 },
    "resource": { "moveCount": 0 },
    "wrapFunction": "moveIncremented",
    "wrapOperation": "update"
  },
  {
    "description": "participantsUnchanged denies when host changes",
    "expectation": "DENY",
    "method": "update",
    "path": "test/game1",
