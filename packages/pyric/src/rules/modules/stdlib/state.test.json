    "auth": { "uid": "user1" },
    "resource": { "status": "waiting" },
    "wrapFunction": "isPlaying",
    "wrapOperation": "update"
  },
  {
    "description": "moveIncremented allows 0 to 1",
    "expectation": "ALLOW",
    "method": "update",
    "path": "test/game1",
    "auth": { "uid": "user1" },
    "data": { "moveCount": 1 },
    "resource": { "moveCount": 0 },
    "wrapFunction": "moveIncremented",
    "wrapOperation": "update"
  },
  {
    "description": "moveIncremented denies skip from 0 to 5",
    "expectation": "DENY",
    "method": "update",
