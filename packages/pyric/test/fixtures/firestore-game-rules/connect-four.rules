      // Gravity: piece lands at lowest empty row in column
      return ((nc == 0 && ((nr == 0 && ob.c0r0 == '') || (nr == 1 && ob.c0r0 != '' && ob.c0r1 == '') || (nr == 2 && ob.c0r0 != '' && ob.c0r1 != '' && ob.c0r2 == '') || (nr == 3 && ob.c0r0 != '' && ob.c0r1 != '' && ob.c0r2 != '' && ob.c0r3 == '') || (nr == 4 && ob.c0r0 != '' && ob.c0r1 != '' && ob.c0r2 != '' && ob.c0r3 != '' && ob.c0r4 == '') || (nr == 5 && ob.c0r0 != '' && ob.c0r1 != '' && ob.c0r2 != '' && ob.c0r3 != '' && ob.c0r4 != '' && ob.c0r5 == '')))
