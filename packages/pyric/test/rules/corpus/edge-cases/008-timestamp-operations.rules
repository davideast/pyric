// Timestamp operations and request.time
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      // Must be in the future
      allow create: if request.resource.data.startsAt is timestamp
                    && request.resource.data.startsAt > request.time;

      // Rate limiting: last update was more than 60 seconds ago
      allow update: if request.time > resource.data.updatedAt + duration.value(60, 's');

      allow read: if true;
      allow delete: if request.auth != null;
    }
  }
}
