    "@inbrowser/model": "^0.4.2",
    "@inbrowser/resumable": "^0.4.1",
    "@inbrowser/workspace": "^0.4.2",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild-wasm": "^0.25.0",
    "firebase": "^12.12.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
