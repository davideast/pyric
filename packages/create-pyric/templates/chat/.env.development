# Loaded by Vite for `--mode development`, which includes the served sandbox
# build (`npm run build:sandbox`). Vite otherwise treats every `vite build` as
# NODE_ENV=production, which turns off pyric's listener attribution and the
# React component capture behind it. Development is also what the plain
# `vite dev` path runs as, so the two sandbox paths behave the same.
NODE_ENV=development
