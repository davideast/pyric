{
  "name": "pyric-tools",
  "version": "0.1.0-alpha.8",
  "description": "Pyric CLI binary (`pyric`) + programmatic deploy / bridge / discover / auth-config helpers. Mirrors firebase-tools.",
  "type": "module",
  "exports": {
    "./deploy": {
      "types": "./dist/deploy/index.d.ts",
      "import": "./dist/deploy/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js"
    },
    "./credentials": {
      "types": "./dist/credentials/index.d.ts",
      "import": "./dist/credentials/index.js"
    },
    "./credentials/node": {
      "types": "./dist/credentials/node/index.d.ts",
      "import": "./dist/credentials/node/index.js"
    },
    "./verify": {
      "types": "./dist/verify/index.d.ts",
      "import": "./dist/verify/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/server.d.ts",
      "node": {
        "types": "./dist/bridge/server.d.ts",
        "import": "./dist/bridge/server.js"
      },
      "browser": {
        "types": "./dist/bridge/client.d.ts",
        "import": "./dist/bridge/client.js"
      },
      "default": {
        "types": "./dist/bridge/server.d.ts",
        "import": "./dist/bridge/server.js"
      }
    },
    "./bridge/client": {
      "types": "./dist/bridge/client.d.ts",
      "import": "./dist/bridge/client.js"
    },
    "./discover": {
      "types": "./dist/discover/index.d.ts",
      "import": "./dist/discover/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./serve/worker": {
      "types": "./dist/serve/worker/index.d.ts",
      "import": "./dist/serve/worker/index.js"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "node": {
        "types": "./dist/remote/index.d.ts",
        "import": "./dist/remote/index.js"
      }
    },
    "./register": {
      "types": "./dist/register/index.d.ts",
      "node": {
        "types": "./dist/register/index.d.ts",
        "import": "./dist/register/index.js"
      }
    }
  },
  "bin": {
    "pyric": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && bun run scripts/postbuild.ts",
    "test": "bun test",
    "test:soak": "playwright test --config test/e2e/soak/playwright.config.ts",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "compile": "bun scripts/compile.ts",
    "release": "bun scripts/release.ts",
    "smoke:standalone": "bun scripts/standalone-smoke.ts",
    "smoke:vendor": "bun scripts/standalone-vendor-smoke.ts"
  },
  "dependencies": {
    "@inbrowser/agent": "0.4.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "esbuild": "^0.28.0",
    "fflate": "^0.8.2",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.0.0",
    "pyric": "workspace:*",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "latest",
    "@types/ws": "^8.5.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.0.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
