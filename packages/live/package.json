{
  "name": "@pyric/live",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "pyric-live": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "description": "Live mode: the app's own Firebase SDK, observed as it talks to a real project. Private until live mode is complete.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./page-modules": {
      "types": "./dist/page-modules.d.ts",
      "default": "./dist/page-modules.js"
    },
    "./register": "./dist/register.js",
    "./node-modules": "./dist/node-modules.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "firebase": "^12.19.0",
    "typescript": "^5.7.0"
  }
}
