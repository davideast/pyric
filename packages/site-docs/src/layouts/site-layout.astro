---
interface Props {
  title: string;
  description?: string;
  studioTheme?: boolean;
}

const { title, description, studioTheme = false } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <link rel="icon" type="image/svg+xml" href={`${base}pyric-logo.svg`} />
    {
      studioTheme ? (
        <script is:inline>
          try {
            localStorage.setItem('pyric-studio:theme', 'dark');
          } catch {}
          document.documentElement.setAttribute('data-theme', 'dark');
        </script>
      ) : null
    }
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/jwb3ycu.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* Both scrolling and app-height pages reserve the scrollbar gutter,
         so the centered studio bar never shifts between routes. */
      html {
        scrollbar-gutter: stable;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
