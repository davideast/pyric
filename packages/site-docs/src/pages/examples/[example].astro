---
import { ExampleRuntime } from '../../components/example-runtime';
import { ChessShowcase } from '../../components/chess-showcase';
import { PYRIC_EXAMPLES, pyricExample, type PyricExampleId } from '../../examples/registry';
import ExampleLayout from '../../layouts/example-layout.astro';

export function getStaticPaths() {
  return Object.keys(PYRIC_EXAMPLES).map((example) => ({ params: { example } }));
}

const id = Astro.params.example as PyricExampleId;
const definition = pyricExample(id).definition;
---

<ExampleLayout title={definition.header}>
  {definition.renderer === 'chess'
    ? <ChessShowcase client:only="react" />
    : <ExampleRuntime id={id} client:only="react" />}
</ExampleLayout>
