---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import DocsLayout from '../../layouts/DocsLayout.astro';
import PyricExample from '../../components/pyric-example.astro';
import ExampleGallery from '../../components/example-gallery.astro';
import ExampleDocPage from '../../components/example-doc-page.astro';
import { pyricExample } from '../../examples/registry';
import { allDocs, slugOf, type DocEntry } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await allDocs();
  return entries.map((entry) => ({
    params: { slug: slugOf(entry) },
    props: { entry },
  }));
}

interface Props {
  entry: DocEntry;
}

const { entry } = Astro.props;
const Content = entry.Content as AstroComponentFactory;
const registeredExample = entry.data.example ? pyricExample(entry.data.example) : undefined;
const isShowcase = registeredExample?.definition.presentation === 'showcase';
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={entry.headings}
  currentSlug={slugOf(entry)}
  kind={entry.data.kind}
  apiPackage={entry.data.apiPackage}
  apiImportPath={entry.data.apiImportPath}
  apiSymbolCount={entry.data.apiSymbolCount}
  apiEvidenceSlug={entry.data.apiEvidenceSlug}
  examplePage={isShowcase}
>
  {isShowcase && entry.data.example
    ? <ExampleDocPage id={entry.data.example}><Content /></ExampleDocPage>
    : <>
        <Content />
        {entry.data.gallery ? <ExampleGallery /> : null}
        {entry.data.example ? <PyricExample id={entry.data.example} /> : null}
      </>}
</DocsLayout>
