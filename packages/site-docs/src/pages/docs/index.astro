---
import { withBase } from '../../lib/content';
const target = withBase('/docs/overview/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Pyric docs</title>
    <style>
      /* This page exists only long enough to forward to the Overview.
         It paints as a quiet docs-colored frame, never a readable
         interstitial; the link is the no-refresh fallback, revealed
         only after a beat. */
      html {
        background: #16161a;
        color: #72728a;
        font: 14px -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
      }
      a {
        color: inherit;
        opacity: 0;
        animation: reveal 0s 1.5s forwards;
      }
      @keyframes reveal {
        to {
          opacity: 1;
        }
      }
    </style>
  </head>
  <body>
    <p><a href={target}>Open the Pyric docs</a></p>
  </body>
</html>
