---
import { withBase, STUDIO_TABS } from '../lib/content';
import SiteLayout from '../layouts/site-layout.astro';
import '../styles/site.css';
import '../styles/rhythm.css';
---

<SiteLayout title="Pyric — A local first Firebase development framework built for Agents" description="Firebase development without production consequences. Give coding agents deep Firebase intelligence and local sandboxing. Ship to prod without code changes." studioTheme={true}>
  {/* Studio Header Bar */}
  <header class="studio__bar">
    <div class="studio__bar-inner">
      <a class="studio__brand" href={withBase('/')} aria-label="Pyric Studio">
        <span class="brand-name">pyric</span>
      </a>
      <nav class="studio__nav" aria-label="Studio tabs">
        {
          STUDIO_TABS.map((tab) => (
            <a
              class="studio__nav-tab"
              href={withBase(tab.path)}
              aria-current={tab.id === 'home' ? 'page' : undefined}
            >
              {tab.label}
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <main class="sheet">
    {/* Zone 1 */}
    <section class="z1">
      <div class="z1__inner">
        <div class="lockup">
          <div class="z1__headings">
            <h1>Firebase tooling for the agent era</h1>
            <p class="standfirst">A local Firebase dev environment designed to give agents the freedom to build without production consequences.</p>
          </div>
          <div class="actions">
            <a class="btn btn--primary" href={withBase('/docs/overview/')}>Get started</a>
          </div>
        </div>
        <div class="composer">
          <div class="composer__input">
            <span class="composer__glyph" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M3.5 3.5L9 8l-5.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="composer__line" id="composer-command"><span class="sk">/pyric</span> create a realtime kanban app</span>
            <button class="composer__copy" type="button" aria-label="Copy command">
              <svg class="ic-copy" width="15" height="15" viewBox="0 0 16 16" fill="none"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M10.5 5.5V4a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              <svg class="ic-check" width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3.5 8.5L6.5 11.5L12.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <div class="composer__session">
            <div class="turn">
            <p class="say"><span class="say__glyph" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M8 1.5l1.6 4.9L14.5 8l-4.9 1.6L8 14.5 6.4 9.6 1.5 8l4.9-1.6L8 1.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg></span><span class="say__text">Scaffolding a Vite app on a Pyric sandbox, a local Firebase.</span></p>
            <div class="calls">
              <div class="call">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 4.5l4 3.5-4 3.5M8.5 12.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <div class="call__body">
                  <span class="call__cmd">npm create pyric@latest</span>
                </div>
                <svg class="call__status" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div class="call">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2.2l4.8 1.8v3.6c0 3-2 5.2-4.8 6.2-2.8-1-4.8-3.2-4.8-6.2V4l4.8-1.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M5.9 7.9l1.5 1.5 2.7-2.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <div class="call__body">
                  <span class="call__cmd">firestore_lint_rules</span>
                  <span class="call__out">0 errors, 2 warnings</span>
                </div>
                <svg class="call__status" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              </div>
            </div>
            <div class="turn">
            <p class="say"><span class="say__glyph" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M8 1.5l1.6 4.9L14.5 8l-4.9 1.6L8 14.5 6.4 9.6 1.5 8l4.9-1.6L8 1.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg></span><span class="say__text">Adding seed data. The rules only let users write their own cards.</span></p>
            <div class="calls">
              <div class="call">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><ellipse cx="8" cy="3.8" rx="5" ry="1.9" stroke="currentColor" stroke-width="1.5"/><path d="M3 3.8v8.4c0 1 2.2 1.9 5 1.9s5-.9 5-1.9V3.8M3 8c0 1 2.2 1.9 5 1.9S13 9 13 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <div class="call__body">
                  <span class="call__cmd">firestore_batch_write</span>
                  <span class="call__out">Applied 13 write(s)</span>
                </div>
                <svg class="call__status" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div class="call">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><ellipse cx="8" cy="3.8" rx="5" ry="1.9" stroke="currentColor" stroke-width="1.5"/><path d="M3 3.8v8.4c0 1 2.2 1.9 5 1.9s5-.9 5-1.9V3.8M3 8c0 1 2.2 1.9 5 1.9S13 9 13 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <div class="call__body">
                  <span class="call__cmd">firestore_create_document</span>
                  <span class="call__out">set boards/main denied by rules</span>
                </div>
                <svg class="call__status call__status--deny" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </div>
              <div class="call">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.2" stroke="currentColor" stroke-width="1.5"/><path d="M10.2 10.2l3.3 3.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <div class="call__body">
                  <span class="call__cmd">sandbox_inspect</span>
                  <span class="call__out">22 docs, 1 recent denial</span>
                </div>
                <svg class="call__status" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div class="call">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 4.5l4 3.5-4 3.5M8.5 12.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <div class="call__body">
                  <span class="call__cmd">pyric firestore indexes generate</span>
                  <span class="call__out">wrote firestore.indexes.json</span>
                </div>
                <svg class="call__status" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </div>
            </div>
            <div class="turn">
            <p class="say"><span class="say__glyph" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M8 1.5l1.6 4.9L14.5 8l-4.9 1.6L8 14.5 6.4 9.6 1.5 8l4.9-1.6L8 1.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg></span><span class="say__text">Done. Live at localhost:5173 on Pyric's sandbox.<span class="say__caret"></span></span></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="z3">
      <div class="z3__inner">
      <img class="z3__art" src={withBase('pyric-campfire-full.png')} alt="" />
      <div class="z3__body">
        <div class="z3__headings">
          <h2>I worked on Firebase for 12 years.</h2>
          <h3>Pyric is the dev tool I always wanted to build.</h3>
        <div class="byline">
          <img src={withBase('david-east.jpg')} alt="" width="40" height="40" />
          <span class="byline__who">
            <span class="byline__name">David East</span>
            <a class="byline__handle" href="https://x.com/_davideast" target="_blank" rel="noopener">@_davideast</a>
          </span>
        </div>
        </div>
        <p>The Firebase dev workflow has always been done against a dev cloud project. Your entire development workflow depends on stateful, network dependent, and billing metered services running in the cloud. Simple workflows like clearing state, seeding data, or testing rules are complicated.</p>
        <p>Now bring in coding agents. When a Firestore read is denied, there's no rich debug data for the call, it's just a <code class="perr">PERMISSION DENIED</code> error. The debug context you need is stuck on a Firebase server, and it's not synthesized with the actual client code that triggered it. Your coding agent is flying blind.</p>
        <p>What if your entire Firebase project lived in a sandbox on your laptop? What if this sandbox provided the same API surface as Firebase with the same behavior? What if you had specialized tools that could inspect this sandbox to provide rich debug data for your coding agent?</p>
        <p class="closer">That's what Pyric is.</p>
      </div>

      <div class="z3__cta">
        <div class="z3__cta-actions">
          <a class="btn btn--primary" href={withBase('/docs/overview/')}>Get started</a>
        </div>
      </div>
      </div>
    </section>

    {/* Zone 4: footer */}
    <section class="z4">
      <footer class="foot">
        <span class="foot__brand">
          <img src={withBase('pyric-campfire.png')} alt="" height="16" />
          pyric
        </span>
        <nav class="foot__links" aria-label="Footer">
          <a href={withBase('/docs/')}>Documentation</a>
          <a href="https://github.com/davideast/pyric" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.npmjs.com/package/pyric" target="_blank" rel="noopener">npm</a>
        </nav>
      </footer>
    </section>
  </main>
</SiteLayout>

<style>
  main.sheet {
    --sheet-ink: var(--ink, #fbfbfe);
    --sheet-muted: var(--muted, #72728a);
    --sheet-faint: #4a4a58;
    --sheet-line: var(--line, #2a2a35);
    --sheet-reading: #c8c8d8;
    --font-label: var(--font-mono, monospace);
    color: var(--sheet-reading);
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [content-start] minmax(0, calc(var(--wide) - 2 * var(--gutter)))
      [content-end] minmax(var(--gutter), 1fr)
      [full-end];
  }
  main.sheet > section {
    grid-column: full;
    display: grid;
    grid-template-columns: subgrid;
  }

  .studio__brand .brand-name {
    font-family: var(--font-display, sans-serif);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--sheet-ink, #fbfbfe);
  }

  .tlabel {
    font-family: var(--font-label);
    font-size: 0.65625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sheet-muted);
    display: inline-flex;
    gap: 0.5625rem;
  }
  .tlabel::before { content: ""; width: 1.375rem; height: 0.0625rem; background: currentColor; }

  .btn {
    position: relative;
    display: inline-flex;
    font-family: var(--font-ui, sans-serif);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.625rem 1.125rem;
    text-decoration: none;
    text-transform: uppercase;
  }
  .btn--primary { background: var(--sheet-ink); color: #14102a; }
  .btn--primary:hover { background: #e2e2ec; }
  .btn--primary:focus-visible { outline: 0.125rem solid var(--accent, #8f7fe8); outline-offset: 0.375rem; }
  /* drafted registration frame: hairline offset from the fill */
  .btn--primary::before {
    content: "";
    position: absolute;
    inset: -0.3125rem;
    border: 0.0625rem solid var(--sheet-line);
    pointer-events: none;
    transition: border-color 0.15s;
  }
  /* crop-mark ticks crossing each corner of the frame */
  .btn--primary::after {
    content: "";
    position: absolute;
    inset: -0.5625rem;
    pointer-events: none;
    color: var(--sheet-muted);
    background-image:
      linear-gradient(currentColor 0 0), linear-gradient(currentColor 0 0),
      linear-gradient(currentColor 0 0), linear-gradient(currentColor 0 0),
      linear-gradient(currentColor 0 0), linear-gradient(currentColor 0 0),
      linear-gradient(currentColor 0 0), linear-gradient(currentColor 0 0);
    background-size:
      0.4375rem 0.0625rem, 0.0625rem 0.4375rem,
      0.4375rem 0.0625rem, 0.0625rem 0.4375rem,
      0.4375rem 0.0625rem, 0.0625rem 0.4375rem,
      0.4375rem 0.0625rem, 0.0625rem 0.4375rem;
    background-position:
      left 0 top 0.25rem, left 0.25rem top 0,
      right 0 top 0.25rem, right 0.25rem top 0,
      left 0 bottom 0.25rem, left 0.25rem bottom 0,
      right 0 bottom 0.25rem, right 0.25rem bottom 0;
    background-repeat: no-repeat;
    transition: color 0.15s;
  }
  .btn--primary:hover::before { border-color: var(--line-2, #3a3a48); }
  .btn--primary:hover::after { color: var(--sheet-reading); }

  .z1 {
    position: relative;
    min-height: 100dvh;
    align-items: center;
  }
  .z1::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url("/hero-charcoal.jpg") center 0% / cover no-repeat;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 58%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 58%);
    opacity: 0.35;
  }
  .z1::after {
    content: "";
    position: absolute; inset: 0;
    background:
      radial-gradient(45rem 30rem ellipse at 18% 55%, rgb(0 0 0 / 0.5), transparent 68%),
      linear-gradient(to bottom, transparent 55%, color-mix(in oklab, var(--bg, #16161a) 30%, transparent));
  }
  .z1 > * { position: relative; z-index: 1; }
  .z1__inner {
    grid-column: content;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
    gap: clamp(1rem, 3vw, 3rem);
    place-items: start;
  }
  .z1__headings {
    display: grid;
    gap: 1.5rem;
  }
  .lockup { 
    display: grid; 
    gap: 2.5rem;
  }
  .z1 h1 {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(2.75rem, 5.6vw + 0.25rem, 4.5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--sheet-ink);
    margin: 0;
    max-width: 14ch;
  }
  .standfirst {
    font-family: var(--font-ui, sans-serif);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.46;
    max-width: 32ch;
    margin: 0;
    color: var(--sheet-reading);
    text-wrap: balance;
    text-shadow: 0 0.0625rem 0.125rem rgb(0 0 0 / 0.6), 0 0 1.5rem rgb(0 0 0 / 0.4);
  }
  .actions { display: flex; gap: 0.875rem; }

  .composer {
    justify-self: end;
    display: grid;
    grid-template-columns:
      [inset-start] 1rem
      [icon] 0.8125rem
      [gap] 0.625rem
      [body] minmax(0, max-content)
      [inset-end] 1rem;
    inline-size: fit-content;
    max-inline-size: 100%;
    border: 0.0625rem solid var(--line-2, #3a3a48);
    border-radius: var(--rounded-lg, 0.375rem);
    background: color-mix(in oklab, var(--bg, #16161a) 55%, var(--panel, #1e1e24));
    overflow: clip;
    text-align: left;
  }
  .composer__input {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: center;
    padding-block: 0.8125rem;
    border-bottom: 0.0625rem solid var(--line, #2a2a35);
    background: var(--panel, #1e1e24);
  }
  .composer__input .composer__glyph { grid-column: icon; grid-row: 1; }
  .composer__input .composer__line { grid-column: body; grid-row: 1; contain: inline-size; }
  .composer__input .composer__copy { grid-column: body; grid-row: 1; justify-self: end; }
  .composer__session {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: 1.375rem;
    padding-block: 1rem 1.125rem;
  }
  .turn {
    grid-column: icon / inset-end;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: 0.75rem;
  }
  .turn > .say { display: contents; }
  .say__glyph { grid-column: 1; }
  .say__text { grid-column: 3; }
  .turn > .calls { grid-column: 3; }
  .say {
    font-family: var(--font-ui, sans-serif);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--sheet-reading);
    margin: 0;
  }
  .say__glyph { display: grid; color: color-mix(in oklab, var(--accent, #8f7fe8) 35%, var(--sheet-muted)); block-size: 1lh; align-items: center; }
  @media (prefers-reduced-motion: reduce) {
    
  }
  @keyframes composer-blink {
    from { opacity: 0.9; }
    to { opacity: 0; }
  }
  .calls {
    display: grid;
    gap: 0.5625rem;
    padding: 0.75rem 0.875rem;
    background: var(--bg, #16161a);
    border: 0.0625rem solid var(--line, #2a2a35);
    border-radius: var(--rounded-md, 0.25rem);
  }
  .call {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.625rem;
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .call > svg {
    color: #6e6e80;
    inline-size: 0.8125rem;
    align-self: center;
  }
  .call__body {
    display: grid;
    row-gap: 0.25rem;
    min-width: 0;
  }
  .call__status {
    color: #6e6e80;
    align-self: center;
  }
  .call__status--deny { color: color-mix(in oklab, var(--diff-remove, #e2607a) 50%, var(--sheet-muted)); }
  .call__cmd {
    font-family: var(--font-label);
    color: var(--sheet-ink);
    overflow-wrap: break-word;
  }
  .call__cmd i {
    font-style: normal;
    color: #a0a0b4;
  }
  .call__out {
    font-family: var(--font-label);
    color: #a0a0b4;
    overflow-wrap: break-word;
  }
  .composer__glyph { display: grid; color: var(--sheet-muted); }
  .composer__line {
    font-family: var(--font-label);
    font-size: clamp(0.875rem, 1.5vw, 1.0625rem);
    color: #e9e9f2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .composer__line .sk { color: var(--accent, #8f7fe8); font-weight: 500; }
  .composer__copy {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border: 0.0625rem solid var(--line-2, #3a3a48);
    border-radius: var(--rounded-md, 0.25rem);
    background: transparent;
    color: var(--sheet-muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .composer__copy:hover { color: var(--sheet-ink); border-color: #4a4a5a; }
  .composer__copy:focus-visible { outline: 0.125rem solid var(--accent, #8f7fe8); outline-offset: 0.125rem; }
  .composer__copy .ic-check { display: none; color: var(--diff-add, #57b985); }
  .composer__copy.copied .ic-copy { display: none; }
  .composer__copy.copied .ic-check { display: block; }


  .z3 {
    border-top: 0.0625rem solid var(--sheet-line);
    padding-block: clamp(5rem, 10vh, 8rem);
  }
  .z3__inner {
    grid-column: content;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 32rem), 1fr));
    gap: clamp(2.5rem,8vw,8rem);
    align-items: center;
  }
  .z3__art {
    inline-size: min(100%, 30rem);
    block-size: auto;
    justify-self: center;
    filter: brightness(1.6);
  }

  .z3__body {
    max-inline-size: 60ch;
  }

  .z3__body {
    display: grid;
    row-gap: 1.75rem;
  }
  .z3__headings {
    display: grid;
    gap: 1rem;
  }
  .z3__body h2 {
    font-family: var(--font-display, sans-serif);
    font-size: 2.125rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--sheet-ink);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .z3__body h3 {
    font-family: var(--font-ui, sans-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--sheet-reading);
    margin: 0;
  }
  .z3__body p { font-size: 1.125rem; line-height: 1.85; margin: 0; color: var(--sheet-reading); }
  .z3__body .perr {
    font-family: var(--font-label);
    font-size: 0.875em;
    color: var(--sheet-ink);
  }
  .z3__body .closer {
    font-family: var(--font-display, sans-serif);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--sheet-ink);
    margin: 0;
  }
  .z3__cta {
    grid-column: 1/-1;
    align-items: center;
    justify-content: center;
    display: flex;
