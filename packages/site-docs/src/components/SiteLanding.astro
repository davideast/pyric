  .z3__cta-actions {
    display: grid;
    justify-content: center;
    align-items: center;
  }
  
  .z3__cta-actions .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-size: 1rem;
  }
  .byline {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.75rem;
  }
  .byline img {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
  }
  .byline__who { display: grid; }
  .byline__name {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sheet-ink);
  }
  .byline__handle {
    font-size: 0.8125rem;
    color: var(--sheet-muted);
    text-decoration: none;
    justify-self: start;
  }
  .byline__handle:hover { color: var(--sheet-ink); }

  /* ── Zone 4: footer ── */
  .z4 { padding-block: clamp(2rem, 4vh, 3rem); }
  .foot {
    grid-column: content;
    display: grid;
