</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.composer__copy');
  btn?.addEventListener('click', async () => {
    const command = document.getElementById('composer-command')?.textContent?.trim() ?? '';
    try {
      await navigator.clipboard.writeText(command);
      btn.classList.add('copied');
      setTimeout(() => btn.classList.remove('copied'), 1600);
    } catch {}
  });
</script>
