---
interface Props {
  header: string;
  subLabel: string;
  summary: string;
}

const { header, subLabel, summary } = Astro.props;
---

<header class="example-header">
  <p>{subLabel}</p>
  <h1>{header}</h1>
  <div>{summary}</div>
</header>

<style>
  .example-header { margin: 0 0 1.5rem; }
  .example-header p { margin: 0 0 .5rem; color: var(--muted); font-family: var(--font-mono); font-size: .7rem; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; }
  .example-header h1 { margin: 0; color: var(--ink); font-size: clamp(1.75rem, 3vw, 2.35rem); font-weight: 600; line-height: 1.15; letter-spacing: -.025em; }
  .example-header div { max-width: 58ch; margin-top: .8rem; color: var(--muted); font-size: 1rem; line-height: 1.55; }
</style>
