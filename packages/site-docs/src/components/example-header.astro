---
import ExampleMeta from './example-meta.astro';

interface Props {
  header: string;
  subLabel: string;
  summary: string;
}

const { header, subLabel, summary } = Astro.props;
---

<header class="example-header">
  <ExampleMeta>{subLabel}</ExampleMeta>
  <h1>{header}</h1>
  <div>{summary}</div>
</header>

<style>
  .example-header { margin: 0 0 1.5rem; }
  .example-header h1 { margin: .5rem 0 0; color: var(--ink); font-size: clamp(1.75rem, 3vw, 2.35rem); font-weight: 600; line-height: 1.15; letter-spacing: -.025em; }
  .example-header div { max-width: 58ch; margin-top: .8rem; color: var(--muted); font-size: 1rem; line-height: 1.55; }
</style>
