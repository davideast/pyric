---
import ExampleHeader from './example-header.astro';
import IsolatedExampleStage from './isolated-example-stage.astro';
import PyricExample from './pyric-example.astro';
import ChessSourceExplorer from './chess-source-explorer.astro';
import { pyricExample, type PyricExampleId } from '../examples/registry';

interface Props { id: PyricExampleId }
const { id } = Astro.props;
const { definition } = pyricExample(id);
const isShowcase = definition.presentation === 'showcase';
---

<div class="example-doc-page">
  <ExampleHeader
    header={definition.header}
    subLabel={definition.subLabel}
    summary={definition.summary}
  />
  {isShowcase
    ? <IsolatedExampleStage id={id} title={definition.header} showcase />
    : <PyricExample id={id} />}
  <article class="prose example-explanation">
    <slot />
  </article>
  {definition.renderer === 'chess' ? (
    <section class="example-rules">
      <h2>Full Security Rules</h2>
      <p>These are the Rules running the board above. Look for the imports at the top, the separate <code>moveType</code> gates, and the explicit king-safety checks.</p>
      <ChessSourceExplorer />
    </section>
  ) : null}
</div>

<style>
  .example-doc-page { width: 100%; }
  .example-explanation { max-width: 72ch; margin-top: 2.5rem; }
  .example-rules { max-width: 72ch; margin-top: 2.5rem; }
  .example-rules h2 { margin: 0 0 .5rem; color: var(--ink); font-size: 1.45rem; }
  .example-rules p { margin: 0 0 1rem; color: var(--muted); line-height: 1.6; }
</style>

<style is:global>
  .source-explorer { overflow: hidden; border: 1px solid var(--line); border-radius: .5rem; background: #111118; }
  .source-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .7rem .8rem; border-bottom: 1px solid #353540; color: #f4f4f7; }
  .source-toolbar strong { font-size: .8rem; }
  .source-toolbar button { border: 1px solid #4a4a58; border-radius: .35rem; padding: .38rem .55rem; background: #24242f; color: #f4f4f7; cursor: pointer; }
  .source-explorer pre.astro-code { max-height: 34rem; margin: 0; overflow: auto; padding: 1rem; background-color: #111118 !important; font: .76rem/1.55 'JetBrains Mono', monospace; }
</style>
