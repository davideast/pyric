---
import {
  navGroups,
  docPath,
  navLabel,
  slugOf,
  groupAnchorId,
  sectionAnchorId,
  isGuideGroup,
  groupLanding,
} from '../lib/docs';
import DocsSearch from './DocsSearch.astro';

interface Props {
  currentSlug: string;
  /** 'primary' (the real sticky sidebar) owns the group/section anchor
   *  ids the breadcrumb fallback jumps to; 'drawer' (the mobile
   *  duplicate — hidden on wide screens) must not repeat them, or the
   *  ids collide and the browser resolves fragment links to whichever
   *  copy is first in the DOM, which on desktop is the hidden one. */
  variant?: 'primary' | 'drawer';
}

const { currentSlug, variant = 'primary' } = Astro.props;
const groups = await navGroups();

/** The nav is a guide, not a manual: guide groups render in full; every
 *  reference group collapses to one link (its overview page) under a
 *  single Reference disclosure. Reference pages stay built, searchable,
 *  and listed in llms.txt/index.json — they are reachable from their
 *  overview and from in-page links, just not itemized in the sidebar. */
const guideGroups = groups.filter((g) => isGuideGroup(g.group));
const apiReferenceGroup = groups.find((g) => g.group === 'API reference');
const referenceGroups = groups.filter(
  (g) => !isGuideGroup(g.group) && g.group !== 'API reference',
);

/** Only the group holding the current page starts open — everything
 *  else is tertiary and stays behind its disclosure. */
function holdsCurrent(group: (typeof groups)[number]): boolean {
  return group.sections.some((s) =>
    s.entries.some((e) => slugOf(e) === currentSlug),
  );
}

const referenceHoldsCurrent = referenceGroups.some(holdsCurrent);
---

<nav class="docs-nav" aria-label="Documentation">
  <DocsSearch />
  {
    guideGroups.map((group) => {
      // A group with exactly one page is a direct link, never a
      // disclosure over a single item ("Overview > Overview").
      const entries = group.sections.flatMap((s) => s.entries);
      if (entries.length === 1) {
        const only = entries[0];
        return (
          <a
            class="docs-nav-toplink"
            href={docPath(only)}
            id={variant === 'primary' ? groupAnchorId(group.group) : undefined}
            aria-current={slugOf(only) === currentSlug ? 'page' : undefined}
          >
            {group.group}
          </a>
        );
      }
      return (
      <details
        class="docs-nav-group"
        id={variant === 'primary' ? groupAnchorId(group.group) : undefined}
        open={holdsCurrent(group)}
      >
        <summary>{group.group}</summary>
        <div class="docs-nav-group-body">
          {group.sections.map(({ section, entries }) => (
            <div class="docs-nav-section">
              {section ? (
                <h2
                  class="docs-nav-heading"
                  id={
                    variant === 'primary'
                      ? sectionAnchorId(group.group, section)
                      : undefined
                  }
                >
                  {section}
                </h2>
              ) : null}
              <ul>
                {entries.map((entry) => (
                  <li>
                    <a
                      href={docPath(entry)}
                      aria-current={
                        slugOf(entry) === currentSlug ? 'page' : undefined
                      }
                    >
                      {navLabel(entry)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>
      );
    })
  }
  {
    apiReferenceGroup && (
      <a
        class="docs-nav-toplink"
        href={docPath(groupLanding(apiReferenceGroup))}
        id={
          variant === 'primary'
            ? groupAnchorId(apiReferenceGroup.group)
            : undefined
        }
        aria-current={holdsCurrent(apiReferenceGroup) ? 'true' : undefined}
      >
        API reference
      </a>
    )
  }
  {
    referenceGroups.length > 0 && (
      <details
        class="docs-nav-group"
        id={variant === 'primary' ? groupAnchorId('Reference') : undefined}
        open={referenceHoldsCurrent}
      >
        <summary>Reference</summary>
        <div class="docs-nav-group-body">
          <div class="docs-nav-section">
            <ul>
              {referenceGroups.map((group) => {
                const landing = groupLanding(group);
                return (
                  <li>
                    <a
                      href={docPath(landing)}
                      aria-current={
                        holdsCurrent(group) ? 'true' : undefined
                      }
                    >
                      {group.group}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </details>
    )
  }
</nav>
