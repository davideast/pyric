{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firebase-config.json",
  "functions": [
    {
      "source": "functions/inference-api",
      "codebase": "inference-api",
      "ignore": [
        ".git",
        ".runtimeconfig.json",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "node_modules"
      ]
    }
  ],
  "hosting": {
    "site": "digame-mas",
    "public": "dist/client",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "inferenceApi",
          "region": "us-central1"
        }
      }
    ]
  }
}
