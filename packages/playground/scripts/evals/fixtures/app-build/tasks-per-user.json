{
  "id": "tasks-per-user",
  "domain": "tasks",
  "auth": "email/password",
  "security": "per-user ownership",
  "prompt": "Build a tasks app where a signed-in user can read, create, update, and delete only their own tasks. Store each task at /tasks/{taskId} with an ownerId field equal to the creator's uid. Use email/password sign-in. Write the Firestore rules and a minimal App.tsx.",
  "cases": [
    { "method": "create", "path": "tasks/t1", "auth": { "uid": "alice" }, "data": { "ownerId": "alice", "title": "buy milk" }, "expect": "ALLOW" },
    { "method": "create", "path": "tasks/t1", "auth": { "uid": "alice" }, "data": { "ownerId": "bob", "title": "x" }, "expect": "DENY" },
    { "method": "get", "path": "tasks/t1", "auth": { "uid": "alice" }, "resource": { "ownerId": "alice" }, "expect": "ALLOW" },
    { "method": "get", "path": "tasks/t1", "auth": { "uid": "bob" }, "resource": { "ownerId": "alice" }, "expect": "DENY" },
    { "method": "get", "path": "tasks/t1", "auth": null, "expect": "DENY" }
  ]
}
