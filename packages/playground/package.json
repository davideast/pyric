{
  "name": "@pyric/playground",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun scripts/with-playground-env.ts astro dev",
    "dev:host": "bun scripts/with-playground-env.ts astro dev --host",
    "start": "bun scripts/with-playground-env.ts astro dev",
    "build": "bun --env-file=../../.env --env-file=.env scripts/build-fn.ts && bun --env-file=../../.env --env-file=.env astro build",
    "build:fn": "bun --env-file=../../.env --env-file=.env scripts/build-fn.ts",
    "preview": "astro preview",
    "preview:tailnet": "bun --env-file=../../.env --env-file=.env astro preview --host 127.0.0.1 --port 4321",
    "astro": "astro",
    "deploy": "bun --env-file=../../.env scripts/deploy.ts",
    "authorize-domain": "bun --env-file=../../.env scripts/authorize-domain.ts",
    "evals": "bun --env-file=../../.env scripts/run-evals.ts",
    "evals:baseline": "bun --env-file=../../.env scripts/run-evals.ts --baseline",
    "probe:discover": "bun --env-file=../../.env scripts/probe-discover.ts",
    "debug:driver": "bun --env-file=../../.env --env-file=.env scripts/playground-debug.ts",
    "debug:fixtures": "bun --env-file=../../.env --env-file=.env scripts/run-fixtures.ts",
    "test": "bun test src functions scripts",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config=tests/e2e/playwright.config.ts --headed",
    "preview:proof": "bun scripts/preview-proof.ts",
    "preview:proof:headed": "bun scripts/preview-proof.ts --headed"
  },
  "dependencies": {
    "@astrojs/node": "^9.0.0",
    "@astrojs/react": "^4.2.0",
    "@astrojs/tailwind": "^6.0.0",
    "@babel/standalone": "^7.29.4",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.42.1",
    "@inbrowser/agent": "0.4.1",
    "@inbrowser/model": "0.4.1",
    "@inbrowser/relay": "0.4.1",
    "@inbrowser/resumable": "0.4.1",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pyric/ui": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^5.0.0",
    "buffer": "^6.0.3",
    "codemirror": "^6.0.2",
    "esbuild-wasm": "^0.25.0",
    "firebase": "^12.13.0",
    "isomorphic-git": "^1.38.1",
    "just-bash": "^3.0.1",
    "pyric": "workspace:*",
    "pyric-admin": "workspace:*",
    "pyric-tools": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9",
    "remark-gfm": "^4",
    "tailwindcss": "^3.4.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.60.0",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "google-auth-library": "^10.0.0",
    "playwright": "^1.60.0",
    "typescript": "^5.7.0"
  }
}
